server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    resolver 1.1.1.1 8.8.8.8 127.0.0.11 valid=30s ipv6=off;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    location /api/ {
        proxy_pass https://ordercraft-backend-427v.onrender.com/api/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ordercraft-backend-427v.onrender.com;
        proxy_set_header Host ordercraft-backend-427v.onrender.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /swagger-ui/ {
        proxy_pass https://ordercraft-backend-427v.onrender.com/swagger-ui/;
        proxy_ssl_server_name on;
        proxy_ssl_name ordercraft-backend-427v.onrender.com;
        proxy_set_header Host ordercraft-backend-427v.onrender.com;
    }

    location /v3/api-docs {
        proxy_pass https://ordercraft-backend-427v.onrender.com/v3/api-docs;
        proxy_ssl_server_name on;
        proxy_ssl_name ordercraft-backend-427v.onrender.com;
        proxy_set_header Host ordercraft-backend-427v.onrender.com;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
